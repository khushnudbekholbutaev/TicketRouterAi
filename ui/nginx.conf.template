server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 2m;

    # Sessiya tekshiruvi: har bir himoyalangan /api so'rovidan oldin API'dagi /auth/check chaqiriladi
    location = /_auth {
        internal;
        proxy_pass http://api:8000/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    # Login / logout / check — ochiq (ichida o'z tekshiruvi bor)
    location /api/auth/ {
        proxy_pass http://api:8000/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /api/health {
        proxy_pass http://api:8000/health;
    }

    # Qolgan API — faqat tizimga kirgan foydalanuvchilar uchun. API-kalitni brauzer emas, nginx qo'shadi
    location /api/ {
        auth_request /_auth;
        proxy_pass http://api:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-API-Key "${API_KEY}";
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
